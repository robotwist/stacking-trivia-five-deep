# Environment variables for development
NODE_ENV=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production-this-should-be-random
DATABASE_URL=postgresql://localhost:5432/deepstack_trivia

# Analytics (optional — nothing sent until set). See docs/ANALYTICS.md and docs/SOFT_LAUNCH.md
# VITE_POSTHOG_KEY=phc_your_project_token
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# For production, set these via your hosting provider:
# NODE_ENV=production
# JWT_SECRET=your-actual-production-secret
# DATABASE_URL=your-production-database-url
# VITE_POSTHOG_KEY=phc_your_project_token
